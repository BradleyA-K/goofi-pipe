nodes:
  syncanalyzer0:
    _type: SyncAnalyzer
    category: analysis
    params:
      sync:
        threshold_ms: 50.0
        window_sec: 2.5
        min_n_events: 2
        timeout_sec: 5.0
      common:
        autotrigger: false
        max_frequency: 30.0
        frequency_mode: updates-per-second
        process_group: ''
    gui_kwargs:
      pos:
      - 239
      - 74
      viewers:
        sync_result:
          viewer_idx: 0
          width: 225
          height: 150
          collapsed: false
          log_scale_x: false
          log_scale_y: false
  midiin0:
    _type: MidiIn
    category: inputs
    params:
      midi:
        ports: '*'
        participant_map: '*:24:P1 , *:40:P2, *:17:P3'
        note_on_only: true
        min_velocity: 1
        print_available_ports: true
      common:
        autotrigger: true
        max_frequency: 30.0
        frequency_mode: updates-per-second
        process_group: ''
    gui_kwargs:
      pos:
      - -22
      - 76
      viewers:
        tap:
          viewer_idx: 0
          width: 175
          height: 100
          collapsed: false
          log_scale_x: false
          log_scale_y: false
  metronomegenerator0:
    _type: MetronomeGenerator
    category: inputs
    params:
      trial:
        bpm: 120.0
        sync_duration_sec: 45.0
        continuation_duration_sec: 35.0
        randomise_bpm: true
        bpm_min: 100.0
        bpm_max: 140.0
        running: false
      click:
        frequency_hz: 1000.0
        duration_ms: 12.0
        volume: 0.8
        sample_rate: 44100
      common:
        autotrigger: true
        max_frequency: 30.0
        frequency_mode: updates-per-second
        process_group: ''
    gui_kwargs:
      pos:
      - -22
      - 266
      viewers:
        beat:
          viewer_idx: 0
          width: 175
          height: 100
          collapsed: false
          log_scale_x: false
          log_scale_y: false
        audio_click:
          viewer_idx: 0
          width: 175
          height: 100
          collapsed: false
          log_scale_x: false
          log_scale_y: false
  audioout0:
    _type: AudioOut
    category: outputs
    params:
      audio:
        sampling_rate: '44100'
        device: MacBook Pro Speakers
        transition_samples: 100
      common:
        autotrigger: false
        max_frequency: 30.0
        frequency_mode: updates-per-second
        process_group: ''
    gui_kwargs:
      pos:
      - 240
      - 355
      viewers:
        finished:
          viewer_idx: 0
          width: 175
          height: 100
          collapsed: false
          log_scale_x: false
          log_scale_y: false
  groupsyncscore0:
    _type: GroupSyncScore
    category: analysis
    params:
      scoring:
        metro_sync_min: 0.20200000703334808
        tempo_tol_ms: 50.0
        smooth: 0.6650000214576721
        expiry_sec: 3.0
      common:
        autotrigger: false
        max_frequency: 30.0
        frequency_mode: updates-per-second
        process_group: ''
    gui_kwargs:
      pos:
      - 527
      - 98
      viewers:
        group_score:
          viewer_idx: 0
          width: 295
          height: 220
          collapsed: false
          log_scale_x: false
          log_scale_y: false
        scores:
          viewer_idx: 0
          width: 275
          height: 200
          collapsed: false
          log_scale_x: false
          log_scale_y: false
  mothserver0:
    _type: MothServer
    category: outputs
    params:
      server:
        port: 8000
        html_path: ''
        value_key: frac_in_sync
        open_browser: true
      common:
        autotrigger: false
        max_frequency: 30.0
        frequency_mode: updates-per-second
        process_group: ''
    gui_kwargs:
      pos:
      - 879
      - 264
      viewers: {}
links:
- node_out: syncanalyzer0
  node_in: groupsyncscore0
  slot_out: sync_result
  slot_in: sync_result
- node_out: midiin0
  node_in: syncanalyzer0
  slot_out: tap
  slot_in: tap
- node_out: metronomegenerator0
  node_in: syncanalyzer0
  slot_out: beat
  slot_in: beat
- node_out: metronomegenerator0
  node_in: audioout0
  slot_out: audio_click
  slot_in: data
- node_out: groupsyncscore0
  node_in: mothserver0
  slot_out: scores
  slot_in: data
